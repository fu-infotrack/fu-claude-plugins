{
  "name": "fu-herdr-tabs",
  "version": "0.1.0",
  "description": "Keep a Herdr tab's label in sync with the Claude session title. SessionStart/Stop hooks rename the calling pane's tab; an optional background watcher covers panes and agents that never fire a Claude hook.",
  "author": {
    "name": "fu-infotrack",
    "url": "https://github.com/fu-infotrack"
  },
  "keywords": ["herdr", "terminal", "tabs", "session", "hooks"],
  "commands": "./commands/",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/src/hooks/sync-tab-label.sh\"",
            "timeout": 10,
            "statusMessage": "Sync herdr tab name"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/src/hooks/sync-tab-label.sh\"",
            "timeout": 10,
            "statusMessage": "Sync herdr tab name"
          }
        ]
      }
    ]
  }
}
