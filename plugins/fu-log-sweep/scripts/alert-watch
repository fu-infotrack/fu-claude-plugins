#!/usr/bin/env bash
# alert-watch — poll the Datadog alert inbox (Teams channel messages a Power
# Automate flow writes into a OneDrive folder) and hand them to the cloud triage
# routine, unread:
#   alert-triage.mjs dispatch  → move every inbox/*.json to processing/, POST their
#                                names in one batch to the routine's /fire endpoint
#                                (alert-triage.fire_url); on a refusal move them
#                                back. The routine reads each file through the M365
#                                connector, triages it and moves it to processed/.
#                                Also keeps processed/ to the newest 100 records.
# The routine's bearer token comes from $ALERT_TRIAGE_FIRE_TOKEN, which this
# script loads from ~/.claude/alert-triage/env (KEY=value lines, chmod 600) —
# create that file yourself; nothing here writes it.
#
#   alert-watch              poll forever (what the systemd unit runs)
#   alert-watch --once       process the inbox once, then exit
#   alert-watch install      copy this script to ~/.claude/alert-triage/ and enable
#                            the fu-alert-watch systemd user service
#   alert-watch uninstall    stop and remove the service (keeps logs and notes)
#   ALERT_TRIAGE_DRY_RUN=1 alert-watch --once   prints the batch; nothing moved, nothing sent
#
# It runs from a fixed path, not the plugin cache (whose path changes with every
# version), and finds the plugin's scripts on each poll — so a plugin update takes
# effect without reinstalling; reinstall only when this file changes.
set -uo pipefail

HOME_DIR=${ALERT_TRIAGE_HOME:-$HOME/.claude/alert-triage}
LOG=$HOME_DIR/log
UNIT=fu-alert-watch.service
UNIT_PATH=$HOME/.config/systemd/user/$UNIT
INTERVAL=${ALERT_TRIAGE_INTERVAL:-30}

mkdir -p "$HOME_DIR"
ENV_FILE=$HOME_DIR/env
# shellcheck disable=SC1090
[ -f "$ENV_FILE" ] && { set -a; . "$ENV_FILE"; set +a; }
log() { printf '%s %s\n' "$(date '+%F %T')" "$*" | tee -a "$LOG" >&2; }

# The plugin's scripts dir: an explicit override, this file's own dir when run
# from a checkout, else the newest installed version in the plugin cache.
scripts_dir() {
  if [ -n "${ALERT_TRIAGE_SCRIPTS:-}" ]; then echo "$ALERT_TRIAGE_SCRIPTS"; return; fi
  local here; here=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
  if [ -f "$here/alert-triage.mjs" ]; then echo "$here"; return; fi
  find "$HOME/.claude/plugins/cache" -path '*/fu-log-sweep/*/scripts/alert-triage.mjs' 2>/dev/null \
    | sed 's#/alert-triage.mjs$##' | sort -V | tail -1
}

case "${1:-}" in
  install)
    src=$(readlink -f "$0")
    install -m 755 "$src" "$HOME_DIR/alert-watch"
    mkdir -p "$(dirname "$UNIT_PATH")"
    cat >"$UNIT_PATH" <<EOF
[Unit]
Description=Send Datadog alerts from the OneDrive inbox to the triage routine (fu-log-sweep)

[Service]
ExecStart=$HOME_DIR/alert-watch
Environment=PATH=$(dirname "$(readlink -f "$(command -v node)")"):/usr/local/bin:/usr/bin:/bin
Restart=on-failure
RestartSec=60

[Install]
WantedBy=default.target
EOF
    systemctl --user daemon-reload && systemctl --user enable --now "$UNIT" \
      && echo "installed: $HOME_DIR/alert-watch, $UNIT enabled. Log: $LOG" \
      && { [ -f "$ENV_FILE" ] || echo "create $ENV_FILE with ALERT_TRIAGE_FIRE_TOKEN=<routine token> (chmod 600)"; } \
      && echo "keep it running with no terminal open: loginctl enable-linger \"\$USER\""
    exit $? ;;
  uninstall)
    systemctl --user disable --now "$UNIT" 2>/dev/null
    rm -f "$UNIT_PATH" "$HOME_DIR/alert-watch"
    systemctl --user daemon-reload
    echo "removed $UNIT (logs and notes kept)"
    exit 0 ;;
esac

# One watcher at a time, or two polls could send the same file twice.
exec 9>"$HOME_DIR/watch.lock"
flock -n 9 || { log "another alert-watch holds $HOME_DIR/watch.lock — exiting"; exit 0; }

while :; do
  S=$(scripts_dir)
  if [ -z "$S" ]; then
    log "fu-log-sweep scripts not found (is the plugin installed?)"
  else
    inbox=$(node "$S/alert-triage.mjs" config | jq -r '.inbox')
    if [ -z "$inbox" ] || [ ! -d "$inbox" ]; then
      log "inbox '${inbox}' missing — set alert-triage.inbox in ~/.claude/fu-tools/config.json"
    else
      line=$(node "$S/alert-triage.mjs" dispatch)
      [ -n "$line" ] && log "$line"
    fi
  fi
  [ "${1:-}" = --once ] && break
  sleep "$INTERVAL"
done
